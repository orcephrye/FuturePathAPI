  "professionsCard": [
    {
      "Title": "Combat Medic",
      "Level": "1",
      "Affinities": [
        "DEX",
        "WIS"
      ],
      "Talents": [
        {
          "Name": "Medic!",
          "Description": "At Combat Medic 1st level, the Combat Medic can more quickly help people in need of aid. Medical skill checks can now be done as a Bonus Action that is granted after performing a Standard Action (Move). The Medic does not need to move any distance to gain this Bonus Action (e.g., preparing tools while standing next to an ally). This only counts for restoring HP, not for stabilizing a dying character.\nNote: While using skills or items in combat normally requires a Standard Action, this feature allows the Medical skill to be performed specifically as a Bonus Action following a move.\n\nWhen a natural 20 is rolled for a Medical skill check, an Inertia point is earned, and the Health restored is the maximum possible."
        },
        {
          "Name": "Quick Chemistry",
          "Description": "At 1st level, the Combat Medic can craft general chemicals and pharmaceuticals more quickly. When using the Craft (Chemical) or Craft (Pharmaceutical) skill to cook General Equipment items, the Combat Medic reduces the cooking/brewing time by 1/2.\nAt 5th level, the Combat Medic reduces the cooking/brewing time of masterworked chemical concoctions by half."
        }
      ]
    }
  ],
