# d20 FuturePath Wiki Fetcher Configuration

# The full URL to your MediaWiki API endpoint
API_URL="https://your-wiki-site.com/wiki/api.php"

# Output directory for raw Wikitext files (Default: wiki_raw_text)
# TXT_OUTPUT_DIR="wiki_raw_text"

# Output directory for converted Markdown files (Default: wiki_markdown)
# MD_OUTPUT_DIR="wiki_markdown"

# Apache Basic Auth Credentials (leave empty if not required)
AUTH_USER=""
AUTH_PASS=""
